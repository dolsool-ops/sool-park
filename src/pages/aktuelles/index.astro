---
import { getCollection } from 'astro:content';
import Section from '../../layouts/Section.astro';
import EntryList from '../../components/EntryList.astro';

const full = { year: 'numeric', month: 'long', day: 'numeric' } as const;
const fmt = (d: Date, o: Intl.DateTimeFormatOptions = full) => d.toLocaleDateString('en-GB', o);
function formatRange(start: Date, end?: Date) {
	if (!end || end.getTime() <= start.getTime()) return fmt(start);
	if (start.getFullYear() === end.getFullYear() && start.getMonth() === end.getMonth())
		return `${start.getDate()}–${fmt(end)}`;
	if (start.getFullYear() === end.getFullYear())
		return `${fmt(start, { month: 'long', day: 'numeric' })} – ${fmt(end)}`;
	return `${fmt(start)} – ${fmt(end)}`;
}

const items = (await getCollection('aktuelles'))
	.filter((e) => !e.id.endsWith('-ko') && !e.id.endsWith('-de'))
	.sort(
		(a, b) =>
			(b.data.datum ?? b.data.pubDate).valueOf() - (a.data.datum ?? a.data.pubDate).valueOf(),
	)
	.map((e) => ({
		href: `/aktuelles/${e.id}/`,
		title: e.data.title,
		eyebrow: e.data.ort,
		meta: formatRange(e.data.datum ?? e.data.pubDate, e.data.datumBis),
		description: e.data.description,
	}));
---

<Section
	title="News & Events"
	description="Conferences, talks, readings and announcements by Sool Park."
	intro="Conferences, lectures, readings and announcements."
>
	<EntryList items={items} />
</Section>
