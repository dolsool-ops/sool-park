{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sool-park",
	"compatibility_date": "2026-06-01",
	// Worker for /api/* (seminar chat) and the seminar pages (release one week ahead);
	// everything else is served straight from ./dist
	"main": "worker/index.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*", "/teaching/digitalitaet/*"]
	},
	// Seminar chat: reader context, budget and rate counters.
	// KV namespace "SEMINAR" (created 2026-10-17).
	"kv_namespaces": [{ "binding": "SEMINAR", "id": "4b1e858c12d743ceaaf85ff3f26a0932" }]
	// Secrets (never in this file): ANTHROPIC_API_KEY, SEMINAR_CODE
	//   local: .dev.vars   live: npx wrangler secret put <NAME>
}
